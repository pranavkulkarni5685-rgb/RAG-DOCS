# =========================================================
# Environment Variables for AI Document Assistant
# Copy this file to .env or export these variables in your environment
# =========================================================

# Google Gemini API Key (Required for Embedding generation & Chat answers)
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=8080

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ai_document_assistant?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# File Upload Configuration
FILE_UPLOAD_DIR=D:/ai-document-assistant/uploads
MAX_FILE_SIZE=52428800
MAX_REQUEST_SIZE=52428800

# RAG & AI Hyperparameters
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.40
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
